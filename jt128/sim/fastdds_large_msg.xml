<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS 大消息配置（JT128 HIL 专用）

  问题：JT128 单回波 10 Hz 每帧 1.84 MB，而本机
    net.core.rmem_max = 212992 (208 KB)
    Fast DDS 默认共享内存段 ≈ 536 KB
  两者都装不下一帧点云 → 消息退回 UDP 分片重组 → 大量丢帧
  （实测：发布端稳定 10 Hz，C++ 订阅端只收到 1~2 Hz）。

  做法：把共享内存段放大到 64 MB，并给 UDP 通道申请大缓冲。
  SHM 这条路不需要 root；UDP 那条即使申请 8 MB 也会被内核
  rmem_max 截到 208 KB，所以真正起作用的是 SHM。

  用法（发布端和接收端**都要**设，且要在同一个 shell 里）：
      export FASTRTPS_DEFAULT_PROFILES_FILE=$HOME/jt128/sim/fastdds_large_msg.xml
  建议直接写进 ~/.zshrc，或启动仿真/驱动前 export 一次。

  验证是否生效：
      ls -la /dev/shm | grep fastrtps     # 段大小应从 ~536 KB 变成 64 MB
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <port_queue_capacity>512</port_queue_capacity>
      <healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
    </transport_descriptor>

    <transport_descriptor>
      <transport_id>udp_large</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>8388608</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="jt128_large_msg" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp_large</transport_id>
      </userTransports>
    </rtps>
  </participant>

</profiles>
